# Copy to .env and fill in only what you use. Never commit .env.
VECTOR_STORE=local            # local (no keys) | pinecone
PINECONE_API_KEY=
PINECONE_INDEX=autoclose-kb
# PINECONE_CLOUD=aws
# PINECONE_REGION=us-east-1

LLM_PROVIDER=offline          # offline (no keys) | anthropic | bedrock
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5
# BEDROCK_MODEL_ID=           # needs AWS credentials and Bedrock model access
# AWS_REGION=us-east-1

# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/autoclose   # default is in-memory SQLite
# AUDIT_RATE=0.05             # share of auto-approved invoices sent to a person anyway

# AUTOCLOSE_ENV=demo          # demo (default): learned cases are cleared at start and on Reset | production: they persist


# AGENT_MODE=workflow          # workflow (default): fixed steps | agentic: the model chooses its own tools (needs anthropic or bedrock)
# AGENT_MAX_STEPS=8
